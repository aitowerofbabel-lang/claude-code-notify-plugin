  "version": "0.5.0",
  "description": "桌面通知插件 - 任务完成和需要输入时显示右下角通知",
  "author": "Claude Code Community",
  "hooks": [
    "Notification",
    "TaskCompleted"
  ],
  "platform": "windows",
